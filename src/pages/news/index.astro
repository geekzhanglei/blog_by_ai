---
import news from '../../data/news.json';
import newsCss from '../../styles/news.css?raw';

const requiredCategories = ['国际', '财经', '科技', '产业', '健康', '能源'];
const isTimestamp = (value: unknown) => typeof value === 'string' && Number.isFinite(Date.parse(value));
const isValidItem = (item: typeof news.items[number]) => item.id
  && requiredCategories.includes(item.category)
  && item.headline
  && item.summary
  && item.whyItMatters
  && item.source
  && item.sourceUrl.startsWith('https://')
  && Number.isFinite(item.priority)
  && item.priority >= 1
  && item.priority <= 3
  && isTimestamp(item.publishedAt)
  && Date.parse(item.publishedAt) >= Date.parse(news.coverageStart)
  && Date.parse(item.publishedAt) <= Date.parse(news.updatedAt);

if (!isTimestamp(news.coverageStart) || !isTimestamp(news.updatedAt) || Date.parse(news.coverageStart) >= Date.parse(news.updatedAt) || news.items.length < 20 || news.items.length > 30 || !news.items.every(isValidItem) || requiredCategories.some((category) => news.items.filter((item) => item.category === category).length < 3)) {
  throw new Error('News data must contain 20–30 recent, categorized events with an actual update time');
}

const categoryCounts = new Map(requiredCategories.map((value) => [value, news.items.filter((item) => item.category === value).length]));
const requestedCategory = Astro.url.searchParams.get('category') || '全部';
const category = requestedCategory === '全部' || requiredCategories.includes(requestedCategory) ? requestedCategory : '全部';
const categories = ['全部', ...requiredCategories];
const sortByNewest = (items: typeof news.items) => items.toSorted((a, b) => Date.parse(b.publishedAt) - Date.parse(a.publishedAt));
const timelineItems = sortByNewest(category === '全部' ? news.items : news.items.filter((item) => item.category === category));
const focusItems = category === '全部' ? [...news.items].toSorted((a, b) => a.priority - b.priority || Date.parse(b.publishedAt) - Date.parse(a.publishedAt)).slice(0, 3) : [];
const timeFormatter = new Intl.DateTimeFormat('zh-CN', { hour: '2-digit', minute: '2-digit', hour12: false, timeZone: 'Asia/Shanghai' });
const shortFormatter = new Intl.DateTimeFormat('zh-CN', { month: 'numeric', day: 'numeric', hour: '2-digit', minute: '2-digit', hour12: false, timeZone: 'Asia/Shanghai' });
const updatedFormatter = new Intl.DateTimeFormat('zh-CN', { year: 'numeric', month: 'long', day: 'numeric', weekday: 'short', hour: '2-digit', minute: '2-digit', second: '2-digit', hour12: false, timeZone: 'Asia/Shanghai' });
const dayFormatter = new Intl.DateTimeFormat('zh-CN', { month: 'long', day: 'numeric', weekday: 'short', timeZone: 'Asia/Shanghai' });
const timelineDays = Object.values(timelineItems.reduce<Record<string, { label: string; items: typeof news.items }>>((groups, item) => {
  const date = new Date(item.publishedAt);
  const key = new Intl.DateTimeFormat('en-CA', { timeZone: 'Asia/Shanghai' }).format(date);
  (groups[key] ||= { label: dayFormatter.format(date), items: [] }).items.push(item);
  return groups;
}, {}));
const categoryHref = (value: string) => value === '全部' ? '/' : `/?category=${encodeURIComponent(value)}`;
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="GPT 按最近 24 小时采集窗口整理 20 至 30 条跨行业重要新闻，并以事件流呈现。" />
    <meta name="generator" content={Astro.generator} />
    <title>{category === '全部' ? '要闻追踪' : `${category}要闻`} · FEROAD NEWS</title>
    <style is:inline set:html={newsCss}></style>
  </head>
  <body>
    <div class="topbar">
      <div class="topbar__inner">
        <span class="status">GPT 已完成本轮采集</span>
        <time datetime={news.updatedAt}>实际更新于 {updatedFormatter.format(new Date(news.updatedAt))}（北京时间）</time>
      </div>
    </div>

    <header class="masthead">
      <div class="masthead__row shell">
        <p class="masthead__edition">24 小时事件流</p>
        <a class="brand" href="/" aria-label="FEROAD NEWS 首页">
          <span class="brand__cn">要闻追踪</span>
          <span class="brand__en">FEROAD NEWS</span>
        </a>
        <a class="about" href="https://www.feroad.com">FEROAD.COM ↗</a>
      </div>
    </header>

    <nav class="category-nav" aria-label="新闻行业分类">
      <div class="category-nav__inner">
        {categories.map((value) => (
          <a class="category-link" href={categoryHref(value)} aria-current={category === value ? 'page' : undefined}>
            {value}<small>{value === '全部' ? news.items.length : categoryCounts.get(value)}</small>
          </a>
        ))}
      </div>
    </nav>

    <main class="shell">
      <section class="edition" aria-labelledby="page-title">
        <div>
          <p class="kicker">{category === '全部' ? '全行业监测' : `${category}分类监测`}</p>
          <h1 id="page-title">{category === '全部' ? '本轮重要事件' : `${category}事件流`}</h1>
        </div>
        <p>覆盖 {shortFormatter.format(new Date(news.coverageStart))} 至 {shortFormatter.format(new Date(news.updatedAt))}<br />共 {timelineItems.length} 条，按发生时间倒序</p>
      </section>

      <section class="topic-panel" aria-labelledby="topic-title">
        <div class="topic-panel__heading">
          <div>
            <p class="kicker">浏览器本地订阅</p>
            <h2 id="topic-title">我的关注流</h2>
          </div>
          <p>订阅只保存在这台设备。例如：A股、AI、原油。</p>
        </div>
        <form class="topic-form" id="topic-form">
          <label class="sr-only" for="topic-input">添加关注话题</label>
          <input id="topic-input" name="topic" type="search" maxlength="30" placeholder="输入关注话题，如 A股" autocomplete="off" />
          <button type="submit">订阅</button>
        </form>
        <div class="topic-chips" id="topic-chips" aria-label="已订阅话题"></div>
        <div class="topic-feed" id="topic-feed" aria-live="polite"></div>
      </section>

      {focusItems.length > 0 && (
        <section class="focus" aria-labelledby="focus-title">
          <div class="section-heading">
            <h2 id="focus-title">本轮焦点</h2>
            <span>影响范围与紧迫性优先</span>
          </div>
          <div class="focus__grid">
            {focusItems.map((story, index) => (
              <article class="focus-card">
                <div class="focus-card__meta"><span>0{index + 1}</span><time datetime={story.publishedAt}>{timeFormatter.format(new Date(story.publishedAt))}</time></div>
                <p class="category-label">{story.category}</p>
                <h3><a href={story.sourceUrl} target="_blank" rel="noreferrer">{story.headline}</a></h3>
                <p>{story.summary}</p>
              </article>
            ))}
          </div>
        </section>
      )}

      <section class="timeline" aria-labelledby="timeline-title">
        <div class="section-heading">
          <h2 id="timeline-title">事件时间线</h2>
          <span>{category === '全部' ? '跨行业要闻' : `${category}全部入选新闻`}</span>
        </div>
        {timelineDays.map((day) => (
          <section class="timeline-day">
            <h3>{day.label}<span>{day.items.length} 件</span></h3>
            <div class="timeline-events">
              {day.items.map((story) => (
                <article class="event">
                  <time class="event__time" datetime={story.publishedAt}>{timeFormatter.format(new Date(story.publishedAt))}</time>
                  <div class="event__marker" aria-hidden="true"></div>
                  <div class="event__card">
                    <div class="event__meta"><span class="category-label">{story.category}</span><span>来源 · {story.source}</span></div>
                    <h4><a href={story.sourceUrl} target="_blank" rel="noreferrer">{story.headline}</a></h4>
                    <p>{story.summary}</p>
                    <div class="event__impact"><strong>影响：</strong>{story.whyItMatters}<a href={story.sourceUrl} target="_blank" rel="noreferrer" aria-label={`查看 ${story.source} 原文`}>原文 ↗</a></div>
                  </div>
                </article>
              ))}
            </div>
          </section>
        ))}
      </section>
    </main>

    <script is:inline define:vars={{ newsItems: news.items }}>
      const storageKey = 'feroad-news-topics';
      const topicForm = document.querySelector('#topic-form');
      const topicInput = document.querySelector('#topic-input');
      const topicChips = document.querySelector('#topic-chips');
      const topicFeed = document.querySelector('#topic-feed');
      const aliases = { 'a股': ['a股', '沪深', '上证', '深证', '证监会', '中国出口', '中国通胀', '人民币'] };
      const normalise = (value) => value.trim().replace(/\s+/g, ' ');
      const keyOf = (value) => normalise(value).toLocaleLowerCase();
      const savedTopics = () => {
        try {
          const saved = JSON.parse(localStorage.getItem(storageKey) || '[]');
          return Array.isArray(saved) ? [...new Set(saved.map(normalise).filter(Boolean))].slice(0, 8) : [];
        } catch { return []; }
      };
      let topics = savedTopics();
      const saveTopics = () => {
        try { localStorage.setItem(storageKey, JSON.stringify(topics)); } catch { /* Local storage may be disabled. */ }
      };
      const newsText = (item) => [item.category, item.headline, item.summary, item.whyItMatters].join(' ').toLocaleLowerCase().replace(/\s/g, '');
      const matches = (item, topic) => {
        const key = keyOf(topic).replace(/\s/g, '');
        const terms = aliases[key] || [key];
        return terms.some((term) => newsText(item).includes(term)) || (key === 'a股' && item.category === '财经' && /中国|市场/.test(newsText(item)));
      };
      const create = (tag, className, content) => {
        const element = document.createElement(tag);
        if (className) element.className = className;
        if (content) element.textContent = content;
        return element;
      };
      const render = () => {
        topicChips.replaceChildren();
        topicFeed.replaceChildren();
        topics.forEach((topic) => {
          const chip = create('button', 'topic-chip', `${topic} ×`);
          chip.type = 'button';
          chip.dataset.topic = topic;
          chip.setAttribute('aria-label', `取消订阅 ${topic}`);
          topicChips.append(chip);
        });
        if (!topics.length) {
          topicFeed.append(create('p', 'topic-empty', '添加话题后，这里会显示本轮匹配的新闻。'));
          return;
        }
        const matched = newsItems.filter((item) => topics.some((topic) => matches(item, topic)));
        if (!matched.length) {
          topicFeed.append(create('p', 'topic-empty', '本轮暂无匹配新闻；下次定时更新后会自动重新筛选。'));
          return;
        }
        matched.slice(0, 10).forEach((item) => {
          const article = create('article', 'topic-story');
          const meta = create('p', 'topic-story__meta', `${item.category} · ${new Intl.DateTimeFormat('zh-CN', { hour: '2-digit', minute: '2-digit', hour12: false, timeZone: 'Asia/Shanghai' }).format(new Date(item.publishedAt))}`);
          const title = create('h3', '');
          const link = create('a', '', item.headline);
          link.href = item.sourceUrl;
          link.target = '_blank';
          link.rel = 'noreferrer';
          title.append(link);
          article.append(meta, title, create('p', '', item.summary));
          topicFeed.append(article);
        });
      };
      topicForm.addEventListener('submit', (event) => {
        event.preventDefault();
        const topic = normalise(topicInput.value);
        if (!topic || topics.some((saved) => keyOf(saved) === keyOf(topic))) return;
        topics = [...topics, topic].slice(-8);
        saveTopics();
        topicInput.value = '';
        render();
      });
      topicChips.addEventListener('click', (event) => {
        const button = event.target.closest('button[data-topic]');
        if (!button) return;
        topics = topics.filter((topic) => topic !== button.dataset.topic);
        saveTopics();
        render();
      });
      render();
    </script>

    <footer class="footer">
      <div class="footer__inner">
        <span>GPT 负责发现与摘要；事实以原始报道为准。</span>
        <time datetime={news.updatedAt}>本轮写入：{updatedFormatter.format(new Date(news.updatedAt))}</time>
      </div>
    </footer>
  </body>
</html>
